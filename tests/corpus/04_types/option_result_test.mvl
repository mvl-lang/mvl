// 04_types/option_result_test.mvl — Option and Result construction/handling.
//
// Option[T] and Result[T, E] are the two builtin failure-carrying types.
// MVL has no null and no bare `unwrap()` — callers must destructure via
// match (or `unwrap_or(default)`, or the `?` propagation operator on
// Result-returning fns).

fn parse_positive(s: String) -> Result[Int, String] {
    if s == "0" {
        Err("not positive")
    } else if s == "1" {
        Ok(1)
    } else if s == "2" {
        Ok(2)
    } else {
        Err("unknown")
    }
}

fn double_parsed(s: String) -> Result[Int, String] {
    let n: Int = parse_positive(s)?;
    Ok(n * 2)
}

fn describe(s: String) -> Result[String, String] {
    if s == "" {
        Err("empty")
    } else {
        Ok(s)
    }
}

partial fn find(xs: List[Int], target: Int) -> Option[Int] {
    let i: ref Int = 0;
    let n: Int = xs.len();
    while i < n {
        match xs.get(i) {
            Some(v) => {
                if v == target {
                    return Some(i);
                }
            },
            None => {},
        }
        i = i + 1;
    }
    None
}

test fn option_some_match_extracts_value() -> Unit {
    let x: Option[Int] = Some(42);
    let v: Int = match x {
        Some(n) => n,
        None => 0,
    };
    assert_eq(v, 42);
}

test fn option_none_match_uses_default() -> Unit {
    let x: Option[Int] = None;
    let v: Int = match x {
        Some(n) => n,
        None => -1,
    };
    assert_eq(v, -1);
}

test fn result_ok_match_extracts() -> Unit {
    let r: Result[Int, String] = Ok(7);
    let v: Int = match r {
        Ok(n) => n,
        Err(_) => -1,
    };
    assert_eq(v, 7);
}

test fn result_err_match_default() -> Unit {
    let r: Result[Int, String] = Err("bad");
    let v: Int = match r {
        Ok(n) => n,
        Err(_) => -1,
    };
    assert_eq(v, -1);
}

test fn result_propagation_success() -> Unit {
    let r: Result[Int, String] = double_parsed("1");
    let v: Int = match r {
        Ok(n) => n,
        Err(_) => 0,
    };
    assert_eq(v, 2);
}

test fn result_propagation_short_circuits_on_err() -> Unit {
    let r: Result[Int, String] = double_parsed("0");
    let v: Int = match r {
        Ok(n) => n,
        Err(_) => -99,
    };
    assert_eq(v, -99);
}

test partial fn option_from_search_hit() -> Unit {
    let xs: List[Int] = [10, 20, 30];
    let idx: Int = match find(xs, 20) {
        Some(i) => i,
        None => -1,
    };
    assert_eq(idx, 1);
}

test partial fn option_from_search_miss() -> Unit {
    let xs: List[Int] = [10, 20, 30];
    let idx: Int = match find(xs, 99) {
        Some(i) => i,
        None => -1,
    };
    assert_eq(idx, -1);
}

// Float payloads route through the same i32/i64-typed runtime ctors as
// Int — the WASM backend bit-casts with reinterpret ops around the call (#2038).
test fn option_some_float_match_extracts_value() -> Unit {
    let x: Option[Float] = Some(3.5);
    let v: Float = match x {
        Some(n) => n,
        None => 0.0,
    };
    assert_eq(v, 3.5);
}

test fn option_float_unwrap_or_uses_value_when_some() -> Unit {
    let x: Option[Float] = Some(2.5);
    let v: Float = x.unwrap_or(0.0);
    assert_eq(v, 2.5);
}

test fn option_float_unwrap_or_uses_default_when_none() -> Unit {
    let x: Option[Float] = None;
    let v: Float = x.unwrap_or(9.5);
    assert_eq(v, 9.5);
}

test fn result_ok_float_match_extracts() -> Unit {
    let r: Result[Float, String] = Ok(1.5);
    let v: Float = match r {
        Ok(n) => n,
        Err(_) => -1.0,
    };
    assert_eq(v, 1.5);
}

test fn result_float_unwrap_or_uses_value_when_ok() -> Unit {
    let r: Result[Float, String] = Ok(4.5);
    let v: Float = r.unwrap_or(0.0);
    assert_eq(v, 4.5);
}

test fn result_float_unwrap_or_uses_default_when_err() -> Unit {
    let r: Result[Float, String] = Err("bad");
    let v: Float = r.unwrap_or(8.5);
    assert_eq(v, 8.5);
}

// Regression (#2024): `Result[String, E]::unwrap_or` — the Ok payload is a
// `*MvlString` pointer, not the generic i32-or-i64 shape the WASM backend
// otherwise picks between; a named local (not just a chained call) exercises
// the receiver-aliasing drop path too.
test fn result_string_ok_unwrap_or() -> Unit {
    let r: Result[String, String] = describe("hello");
    assert_eq(r.unwrap_or("default"), "hello");
}

test fn result_string_err_unwrap_or() -> Unit {
    let r: Result[String, String] = describe("");
    assert_eq(r.unwrap_or("default"), "default");
}

// Regression (#2066): `Result[T, E]::Err` only supported a String payload
// in the WASM backend — any other Err type (a custom enum, a plain Int, a
// Float) stubbed the *entire enclosing function* to `unreachable`, not a
// compile error. `Ok`'s constructor already dispatched by payload type;
// `Err`'s never got the same treatment. Also covers the paired extraction
// bug: `Err(e) => ...e...` (a bound, actually-used payload, not `Err(_)`)
// read the wrong runtime struct field for i64-shaped payloads, silently
// truncating anything over i32 range via an unconditional `i32.wrap_i64`.
type AuthError = enum { NotFound, InvalidPassword }

fn authenticate(fail: Bool) -> Result[Int, AuthError] {
    if fail {
        Err(AuthError::InvalidPassword)
    } else {
        Ok(42)
    }
}

fn describe_auth_error(e: AuthError) -> Int {
    match e {
        AuthError::NotFound => 1,
        AuthError::InvalidPassword => 2,
    }
}

test fn result_err_enum_ok_path() -> Unit {
    match authenticate(false) {
        Ok(v) => assert_eq(v, 42),
        Err(_) => assert_eq(1, 0),
    }
}

test fn result_err_enum_discarded() -> Unit {
    match authenticate(true) {
        Ok(_) => assert_eq(1, 0),
        Err(_) => assert_eq(1, 1),
    }
}

test fn result_err_enum_bound_and_used() -> Unit {
    match authenticate(true) {
        Ok(_) => assert_eq(1, 0),
        Err(e) => assert_eq(describe_auth_error(e), 2),
    }
}

fn parse_or_code(fail: Bool) -> Result[Int, Int] {
    if fail {
        Err(9999999999)
    } else {
        Ok(1)
    }
}

test fn result_err_int_bound_beyond_i32_range() -> Unit {
    match parse_or_code(true) {
        Ok(_) => assert_eq(1, 0),
        Err(e) => assert_eq(e, 9999999999),
    }
}
