// 04_types/option_result_test.mvl — Option and Result construction/handling.
//
// Option[T] and Result[T, E] are the two builtin failure-carrying types.
// MVL has no null and no bare `unwrap()` — callers must destructure via
// match (or `unwrap_or(default)`, or the `?` propagation operator on
// Result-returning fns).

fn parse_positive(s: String) -> Result[Int, String] {
    if s == "0" {
        Err("not positive")
    } else if s == "1" {
        Ok(1)
    } else if s == "2" {
        Ok(2)
    } else {
        Err("unknown")
    }
}

fn double_parsed(s: String) -> Result[Int, String] {
    let n: Int = parse_positive(s)?;
    Ok(n * 2)
}

fn describe(s: String) -> Result[String, String] {
    if s == "" {
        Err("empty")
    } else {
        Ok(s)
    }
}

partial fn find(xs: List[Int], target: Int) -> Option[Int] {
    let i: ref Int = 0;
    let n: Int = xs.len();
    while i < n {
        match xs.get(i) {
            Some(v) => {
                if v == target {
                    return Some(i);
                }
            },
            None => {},
        }
        i = i + 1;
    }
    None
}

test fn option_some_match_extracts_value() -> Unit {
    let x: Option[Int] = Some(42);
    let v: Int = match x {
        Some(n) => n,
        None => 0,
    };
    assert_eq(v, 42);
}

test fn option_none_match_uses_default() -> Unit {
    let x: Option[Int] = None;
    let v: Int = match x {
        Some(n) => n,
        None => -1,
    };
    assert_eq(v, -1);
}

test fn result_ok_match_extracts() -> Unit {
    let r: Result[Int, String] = Ok(7);
    let v: Int = match r {
        Ok(n) => n,
        Err(_) => -1,
    };
    assert_eq(v, 7);
}

test fn result_err_match_default() -> Unit {
    let r: Result[Int, String] = Err("bad");
    let v: Int = match r {
        Ok(n) => n,
        Err(_) => -1,
    };
    assert_eq(v, -1);
}

test fn result_propagation_success() -> Unit {
    let r: Result[Int, String] = double_parsed("1");
    let v: Int = match r {
        Ok(n) => n,
        Err(_) => 0,
    };
    assert_eq(v, 2);
}

test fn result_propagation_short_circuits_on_err() -> Unit {
    let r: Result[Int, String] = double_parsed("0");
    let v: Int = match r {
        Ok(n) => n,
        Err(_) => -99,
    };
    assert_eq(v, -99);
}

test partial fn option_from_search_hit() -> Unit {
    let xs: List[Int] = [10, 20, 30];
    let idx: Int = match find(xs, 20) {
        Some(i) => i,
        None => -1,
    };
    assert_eq(idx, 1);
}

test partial fn option_from_search_miss() -> Unit {
    let xs: List[Int] = [10, 20, 30];
    let idx: Int = match find(xs, 99) {
        Some(i) => i,
        None => -1,
    };
    assert_eq(idx, -1);
}

// Float payloads route through the same i32/i64-typed runtime ctors as
// Int — the WASM backend bit-casts with reinterpret ops around the call (#2038).
test fn option_some_float_match_extracts_value() -> Unit {
    let x: Option[Float] = Some(3.5);
    let v: Float = match x {
        Some(n) => n,
        None => 0.0,
    };
    assert_eq(v, 3.5);
}

test fn option_float_unwrap_or_uses_value_when_some() -> Unit {
    let x: Option[Float] = Some(2.5);
    let v: Float = x.unwrap_or(0.0);
    assert_eq(v, 2.5);
}

test fn option_float_unwrap_or_uses_default_when_none() -> Unit {
    let x: Option[Float] = None;
    let v: Float = x.unwrap_or(9.5);
    assert_eq(v, 9.5);
}

test fn result_ok_float_match_extracts() -> Unit {
    let r: Result[Float, String] = Ok(1.5);
    let v: Float = match r {
        Ok(n) => n,
        Err(_) => -1.0,
    };
    assert_eq(v, 1.5);
}

test fn result_float_unwrap_or_uses_value_when_ok() -> Unit {
    let r: Result[Float, String] = Ok(4.5);
    let v: Float = r.unwrap_or(0.0);
    assert_eq(v, 4.5);
}

test fn result_float_unwrap_or_uses_default_when_err() -> Unit {
    let r: Result[Float, String] = Err("bad");
    let v: Float = r.unwrap_or(8.5);
    assert_eq(v, 8.5);
}

// Regression (#2024): `Result[String, E]::unwrap_or` — the Ok payload is a
// `*MvlString` pointer, not the generic i32-or-i64 shape the WASM backend
// otherwise picks between; a named local (not just a chained call) exercises
// the receiver-aliasing drop path too.
test fn result_string_ok_unwrap_or() -> Unit {
    let r: Result[String, String] = describe("hello");
    assert_eq(r.unwrap_or("default"), "hello");
}

test fn result_string_err_unwrap_or() -> Unit {
    let r: Result[String, String] = describe("");
    assert_eq(r.unwrap_or("default"), "default");
}

// Regression (#2066): `Result[T, E]::Err` only supported a String payload
// in the WASM backend — any other Err type (a custom enum, a plain Int, a
// Float) stubbed the *entire enclosing function* to `unreachable`, not a
// compile error. `Ok`'s constructor already dispatched by payload type;
// `Err`'s never got the same treatment. Also covers the paired extraction
// bug: `Err(e) => ...e...` (a bound, actually-used payload, not `Err(_)`)
// read the wrong runtime struct field for i64-shaped payloads, silently
// truncating anything over i32 range via an unconditional `i32.wrap_i64`.
type AuthError = enum { NotFound, InvalidPassword }

fn authenticate(fail: Bool) -> Result[Int, AuthError] {
    if fail {
        Err(AuthError::InvalidPassword)
    } else {
        Ok(42)
    }
}

fn describe_auth_error(e: AuthError) -> Int {
    match e {
        AuthError::NotFound => 1,
        AuthError::InvalidPassword => 2,
    }
}

test fn result_err_enum_ok_path() -> Unit {
    match authenticate(false) {
        Ok(v) => assert_eq(v, 42),
        Err(_) => assert_eq(1, 0),
    }
}

test fn result_err_enum_discarded() -> Unit {
    match authenticate(true) {
        Ok(_) => assert_eq(1, 0),
        Err(_) => assert_eq(1, 1),
    }
}

test fn result_err_enum_bound_and_used() -> Unit {
    match authenticate(true) {
        Ok(_) => assert_eq(1, 0),
        Err(e) => assert_eq(describe_auth_error(e), 2),
    }
}

fn parse_or_code(fail: Bool) -> Result[Int, Int] {
    if fail {
        Err(9999999999)
    } else {
        Ok(1)
    }
}

test fn result_err_int_bound_beyond_i32_range() -> Unit {
    match parse_or_code(true) {
        Ok(_) => assert_eq(1, 0),
        Err(e) => assert_eq(e, 9999999999),
    }
}

// Regression (#2075): match dispatch on an enum with a struct-shaped
// payload variant crashed both backends. LLVM's `switch condition must
// have integer type` came from switching directly on the wrapped enum's
// `{tag,ptr}` tagged-union value instead of extracting its own
// discriminant first. WASM either trapped (`unreachable`) or failed to
// assemble (`unknown local`) because neither backend's checker/codegen
// path resolved a `Pattern::Struct` field's type — it was silently bound
// as `Ty::Unknown`, and no match-arm-local collection pass declared or
// extracted a struct-shaped binding at all. Multiple qualified `Err(...)`
// arms in one match (as below) additionally exercises the two-level
// dispatch neither backend's *single*-qualified-arm path ever reached —
// on WASM specifically, every qualified `Err` arm previously lowered to
// the same bare `tag == 1` check, so only the first one listed ever fired.
type AccessError = enum {
    NotFound,
    InvalidPassword,
    AccountLocked { attempts: Int where self >= 0 },
}

fn classify_access_error(e: AccessError) -> Int {
    match e {
        AccessError::NotFound => 1,
        AccessError::InvalidPassword => 2,
        AccessError::AccountLocked { attempts: attempts } => attempts,
    }
}

test fn struct_payload_variant_bare_match_unit_arms() -> Unit {
    assert_eq(classify_access_error(AccessError::NotFound), 1);
    assert_eq(classify_access_error(AccessError::InvalidPassword), 2);
}

test fn struct_payload_variant_bare_match_bound_field() -> Unit {
    assert_eq(classify_access_error(AccessError::AccountLocked { attempts: 3 }), 3);
}

fn authorize(ok: Bool, locked: Bool) -> Result[Int, AccessError] {
    if ok {
        Ok(42)
    } else if locked {
        Err(AccessError::AccountLocked { attempts: 5 })
    } else {
        Err(AccessError::NotFound)
    }
}

test fn struct_payload_variant_result_err_ok_path() -> Unit {
    match authorize(true, false) {
        Ok(v) => assert_eq(v, 42),
        Err(AccessError::NotFound) => assert_eq(1, 0),
        Err(AccessError::InvalidPassword) => assert_eq(1, 0),
        Err(AccessError::AccountLocked { attempts: attempts }) => assert_eq(attempts, 0),
    }
}

test fn struct_payload_variant_result_err_unit_variant() -> Unit {
    match authorize(false, false) {
        Ok(_) => assert_eq(1, 0),
        Err(AccessError::NotFound) => assert_eq(1, 1),
        Err(AccessError::InvalidPassword) => assert_eq(1, 0),
        Err(AccessError::AccountLocked { attempts: attempts }) => assert_eq(attempts, -1),
    }
}

test fn struct_payload_variant_result_err_bound_field() -> Unit {
    match authorize(false, true) {
        Ok(_) => assert_eq(1, 0),
        Err(AccessError::NotFound) => assert_eq(1, 0),
        Err(AccessError::InvalidPassword) => assert_eq(1, 0),
        Err(AccessError::AccountLocked { attempts: attempts }) => assert_eq(attempts, 5),
    }
}

// #2149: Option[T]::map / Result[T,E]::map / Result[T,E]::and_then had no
// native WASM arm and no std/core.mvl body at all — every call stubbed the
// enclosing function. Uses an enum error type deliberately: an Int error
// would mask the accompanying checker bug (a generic method's `self` type
// wasn't recognized in match-pattern binding, so `Err(e) => Err(e)` bound
// `e` as Ty::Unknown, which happens to default to the same runtime shape
// Int needs — only a non-Int E, like this enum, exposes the corruption).
type MapAndThenError = enum { NonPositive, WasErr }

test fn option_map_transforms_some_value() -> Unit {
    let o: Option[Int] = Some(5);
    let d: Option[Int] = o.map(|x: Int| x * 2);
    match d {
        Some(v) => assert_eq(v, 10),
        None => assert_eq(1, 0),
    }
}

test fn option_map_propagates_none() -> Unit {
    let o: Option[Int] = None;
    let d: Option[Int] = o.map(|x: Int| x * 2);
    match d {
        Some(_) => assert_eq(1, 0),
        None => assert_eq(1, 1),
    }
}

test fn result_map_transforms_ok_value() -> Unit {
    let r: Result[Int, MapAndThenError] = Ok(21);
    let s: Result[Int, MapAndThenError] = r.map(|x: Int| x * 2);
    match s {
        Ok(v) => assert_eq(v, 42),
        Err(_) => assert_eq(1, 0),
    }
}

test fn result_map_propagates_err_enum_unchanged() -> Unit {
    let r: Result[Int, MapAndThenError] = Err(MapAndThenError::WasErr);
    let s: Result[Int, MapAndThenError] = r.map(|x: Int| x * 2);
    match s {
        Ok(_) => assert_eq(1, 0),
        Err(MapAndThenError::WasErr) => assert_eq(1, 1),
        Err(MapAndThenError::NonPositive) => assert_eq(1, 0),
    }
}

test fn result_and_then_chains_into_ok() -> Unit {
    let r: Result[Int, MapAndThenError] = Ok(3);
    let c: Result[Int, MapAndThenError] =
        r.and_then(|x: Int| if x > 0 { Ok(x * 2) } else { Err(MapAndThenError::NonPositive) });
    match c {
        Ok(v) => assert_eq(v, 6),
        Err(_) => assert_eq(1, 0),
    }
}

test fn result_and_then_short_circuits_on_existing_err() -> Unit {
    let r: Result[Int, MapAndThenError] = Err(MapAndThenError::WasErr);
    let c: Result[Int, MapAndThenError] =
        r.and_then(|x: Int| if x > 0 { Ok(x * 2) } else { Err(MapAndThenError::NonPositive) });
    match c {
        Ok(_) => assert_eq(1, 0),
        Err(MapAndThenError::WasErr) => assert_eq(1, 1),
        Err(MapAndThenError::NonPositive) => assert_eq(1, 0),
    }
}

test fn result_and_then_propagates_err_from_lambda() -> Unit {
    let r: Result[Int, MapAndThenError] = Ok(-1);
    let c: Result[Int, MapAndThenError] =
        r.and_then(|x: Int| if x > 0 { Ok(x * 2) } else { Err(MapAndThenError::NonPositive) });
    match c {
        Ok(_) => assert_eq(1, 0),
        Err(MapAndThenError::NonPositive) => assert_eq(1, 1),
        Err(MapAndThenError::WasErr) => assert_eq(1, 0),
    }
}

// #2158: `Option[T]::map`/`Result[T,E]::map`/`Result[T,E]::and_then`'s own
// generic bodies (`match self { Some(x) => Some(f(x)), None => None }`)
// bind `x` from `self`'s *own* `Option[T]`/`Result[T,E]` parameter type,
// which the checker/backends represent with a named-wrapper spelling
// (`Ty::Named("Option", [T])`) rather than the structural `Ty::Option(T)` —
// the same shape #2125/#2149 already had to normalize elsewhere.
// `option_inner_ty`/`result_ok_ty`/`result_err_ty` didn't recognize it, so
// when `T` resolved to a String-shaped type (here `Tainted[String]`), the
// WASM backend declared `x` as a plain scalar local but the emit side
// still referenced the (never-declared) split `$x_ptr`/`$x_len` locals —
// "unknown local" at assembly time. An Int-typed `T` (as in the #2149
// tests above) never exposes this: only a String/labeled-String payload
// needs the ptr/len split at all.
test fn option_map_transforms_tainted_string_value() -> Unit {
    let o: Option[Tainted[String]] = Some(relabel taint("hello", "T-2158-A"));
    let sanitized: Option[String] = o.map(|v: Tainted[String]| relabel trust(v, "T-2158-B"));
    match sanitized {
        Some(s) => assert_eq(s, "hello"),
        None    => assert_eq(1, 0),
    }
}

test fn option_map_propagates_none_for_string_payload() -> Unit {
    let o: Option[Tainted[String]] = None;
    let sanitized: Option[String] = o.map(|v: Tainted[String]| relabel trust(v, "T-2158-C"));
    match sanitized {
        Some(_) => assert_eq(1, 0),
        None    => assert_eq(1, 1),
    }
}

test fn result_map_transforms_ok_string_value() -> Unit {
    let r: Result[String, MapAndThenError] = Ok("hi");
    let s: Result[String, MapAndThenError] = r.map(|v: String| v.to_upper());
    match s {
        Ok(v)  => assert_eq(v, "HI"),
        Err(_) => assert_eq(1, 0),
    }
}

test fn result_and_then_chains_string_into_ok() -> Unit {
    let r: Result[String, MapAndThenError] = Ok("hi");
    let c: Result[String, MapAndThenError] =
        r.and_then(|v: String| Ok(v.to_upper()));
    match c {
        Ok(v)  => assert_eq(v, "HI"),
        Err(_) => assert_eq(1, 0),
    }
}

// #2163 (WASM) / #2177 (LLVM): `Some(Variant(x))` / `Ok(Variant(x))` — a
// payload-enum variant pattern nested one level inside an Option/Result
// wrapper — failed to assemble under WASM ("unknown local: failed to find
// name `$x_ptr`") and crashed under LLVM (the nested variant's own
// discriminant was never checked, so the wrong arm's body ran and read
// fields at the wrong offsets). Matching `Variant(x)` directly (no wrapper)
// already worked on both backends. Surfaced by `std.args`'s
// `get_str`/`get_str_opt` (`Some(ArgValue::Str(s)) => s`) and
// `examples/log_analyzer`'s `Map[String, Value]::get()` results.
type Payload = enum {
    Text(String),
    Num(Int),
}

fn payload_text_in_some(v: Option[Payload]) -> String {
    match v {
        Some(Payload::Text(s)) => s,
        _                      => "none",
    }
}

fn payload_num_in_some(v: Option[Payload]) -> Int {
    match v {
        Some(Payload::Num(n)) => n,
        _                     => -1,
    }
}

fn payload_text_in_ok(v: Result[Payload, String]) -> String {
    match v {
        Ok(Payload::Text(s)) => s,
        _                    => "none",
    }
}

test fn nested_tuplestruct_string_field_in_some() -> Unit {
    assert_eq(payload_text_in_some(Some(Payload::Text("info"))), "info");
    assert_eq(payload_text_in_some(Some(Payload::Num(7))), "none");
    assert_eq(payload_text_in_some(None), "none");
}

test fn nested_tuplestruct_scalar_field_in_some() -> Unit {
    assert_eq(payload_num_in_some(Some(Payload::Num(7))), 7);
    assert_eq(payload_num_in_some(Some(Payload::Text("info"))), -1);
    assert_eq(payload_num_in_some(None), -1);
}

test fn nested_tuplestruct_string_field_in_ok() -> Unit {
    assert_eq(payload_text_in_ok(Ok(Payload::Text("info"))), "info");
    assert_eq(payload_text_in_ok(Ok(Payload::Num(7))), "none");
    assert_eq(payload_text_in_ok(Err("bad")), "none");
}

// Struct-shaped nested variant (named fields, not positional) — reuses
// `AccessError::AccountLocked { attempts }` declared above (#2075).
fn attempts_in_some(v: Option[AccessError]) -> Int {
    match v {
        Some(AccessError::AccountLocked { attempts: attempts }) => attempts,
        _                                                        => -1,
    }
}

fn attempts_in_ok(v: Result[AccessError, String]) -> Int {
    match v {
        Ok(AccessError::AccountLocked { attempts: attempts }) => attempts,
        _                                                      => -1,
    }
}

test fn nested_struct_variant_field_in_some() -> Unit {
    assert_eq(attempts_in_some(Some(AccessError::AccountLocked { attempts: 3 })), 3);
    assert_eq(attempts_in_some(Some(AccessError::NotFound)), -1);
    assert_eq(attempts_in_some(None), -1);
}

test fn nested_struct_variant_field_in_ok() -> Unit {
    assert_eq(attempts_in_ok(Ok(AccessError::AccountLocked { attempts: 9 })), 9);
    assert_eq(attempts_in_ok(Ok(AccessError::NotFound)), -1);
    assert_eq(attempts_in_ok(Err("bad")), -1);
}

// #2168: a qualified `Some(Variant(x))`/`Ok(Variant(x))` arm sharing an
// outer tag with a sibling non-qualified `Some(_)`/`Ok(_)` (or a bound
// `Some(other)`/`Ok(other)`) arm made the sibling's body unreachable on
// LLVM — the discriminant-dispatch block #2177 added only knew how to fall
// through to the match's own trailing wildcard, not to an in-group
// catch-all sitting between the qualified arm and that wildcard.
fn payload_text_or_other_in_some(v: Option[Payload]) -> String {
    match v {
        Some(Payload::Text(s)) => s,
        Some(_)                => "other",
        None                   => "none",
    }
}

fn payload_num_or_bound_in_some(v: Option[Payload]) -> Int {
    match v {
        Some(Payload::Num(n)) => n,
        Some(other)           => match other {
            Payload::Num(n) => n,
            _               => -2,
        },
        None                  => -1,
    }
}

fn payload_text_or_wildcard_in_ok(v: Result[Payload, String]) -> String {
    match v {
        Ok(Payload::Text(s)) => s,
        Ok(_)                => "other",
        Err(_)               => "err",
    }
}

test fn sibling_wildcard_after_qualified_some_arm() -> Unit {
    assert_eq(payload_text_or_other_in_some(Some(Payload::Text("hi"))), "hi");
    assert_eq(payload_text_or_other_in_some(Some(Payload::Num(3))), "other");
    assert_eq(payload_text_or_other_in_some(None), "none");
}

test fn sibling_bound_arm_after_qualified_some_arm() -> Unit {
    assert_eq(payload_num_or_bound_in_some(Some(Payload::Num(7))), 7);
    assert_eq(payload_num_or_bound_in_some(Some(Payload::Text("x"))), -2);
    assert_eq(payload_num_or_bound_in_some(None), -1);
}

test fn sibling_wildcard_after_qualified_ok_arm() -> Unit {
    assert_eq(payload_text_or_wildcard_in_ok(Ok(Payload::Text("hi"))), "hi");
    assert_eq(payload_text_or_wildcard_in_ok(Ok(Payload::Num(3))), "other");
    assert_eq(payload_text_or_wildcard_in_ok(Err("boom")), "err");
}

// #2145: `Option[Unit]`'s payload slot has no meaningful data — under LLVM
// its type resolves to `void`, and matching it (even a `Some(_)` arm that
// never uses the payload) emitted an invalid `load void, ptr %pp`, which
// crashed the whole module at load time. `Result[Unit, E]`'s `Ok` arm
// already had the equivalent guard; `Option`'s `Some` arm never got it.
fn produce_some_unit() -> Option[Unit] {
    Some(())
}

fn produce_none_unit() -> Option[Unit] {
    None
}

test fn option_unit_some_wildcard_match() -> Unit {
    match produce_some_unit() {
        Some(_) => assert_eq(1, 1),
        None    => assert_eq(1, 0),
    }
}

test fn option_unit_none_match() -> Unit {
    match produce_none_unit() {
        Some(_) => assert_eq(1, 0),
        None    => assert_eq(1, 1),
    }
}

test fn option_unit_some_bound_ident_match() -> Unit {
    match produce_some_unit() {
        Some(x) => assert_eq(1, 1),
        None    => assert_eq(1, 0),
    }
}
