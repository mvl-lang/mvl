// 05_collections/list_get_field_receiver_types.mvl — shared types for the
// sibling regression case in list_get_field_receiver.mvl (#2200).
//
// Declared in their own file (not `use`-imported, per MVL's normal
// same-directory implicit visibility) because the bug this guards against
// only manifests when the struct type is declared in a *different* file
// than the code that does a field-access `.get(i)` on it.

type Item = struct {
    visible: Bool,
    name:    String,
}

type Wrapper = struct {
    items: List[Item],
}
