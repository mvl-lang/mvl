// 05_collections/list_get_field_receiver_types.mvl — shared types for the
// sibling regression case in list_get_field_receiver.mvl (#2200).
//
// Declared in their own file — and `use`-imported by the sibling, per
// spec 005-modules Req 2/3 (#2204) — because the bug this guards against
// only manifests when the struct type is declared in a *different* file
// than the code that does a field-access `.get(i)` on it. What matters to
// the regression is the separate *file*, not the absence of an import.

pub type Item = struct {
    visible: Bool,
    name:    String,
}

pub type Wrapper = struct {
    items: List[Item],
}
