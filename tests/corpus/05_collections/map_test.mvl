// 05_collections/map_test.mvl — Map[K, V] construction, lookup, insertion.
//
// Map literal: `{"a": 1, "b": 2}` — non-empty populates a map. `{}` is an
// empty block, not an empty map — `Map[K, V]::new()` is the only way to
// spell an empty one. Most tests here use literal construction and start
// from a small non-empty map when insertion needs to grow it; a dedicated
// case below covers `Map::new()` itself on all three backends (#2164 —
// the WASM backend had no emitter arm for it at all).
//
// `.get(key)` returns `Option[V]` — MVL has no null. `.insert(k, v)` is a
// mutating method requiring `ref Map[K, V]`.

test fn map_literal_and_len() -> Unit {
    let m: Map[String, Int] = {"a": 1, "b": 2, "c": 3};
    assert_eq(m.len(), 3);
}

// #2164: `Map::new()` / `Map[K, V]::new()` had no WASM emitter arm at all
// — every call fell through to the generic named-function-call fallback
// and emitted `call $Map::new`, a symbol nothing declares.
test fn map_new_starts_empty() -> Unit {
    let m: Map[String, Int] = Map[String, Int]::new();
    assert_eq(m.len(), 0);
    assert_eq(m.is_empty(), true);
}

test fn map_new_then_insert_grows_map() -> Unit {
    let m: ref Map[String, Int] = Map[String, Int]::new();
    m.insert("a", 1);
    m.insert("b", 2);
    assert_eq(m.len(), 2);
    assert_eq(m.get("a").unwrap_or(-1), 1);
}

test fn map_get_hit_returns_some() -> Unit {
    let m: Map[String, Int] = {"one": 1, "two": 2, "three": 3};
    let v: Int = match m.get("two") {
        Some(n) => n,
        None => -1,
    };
    assert_eq(v, 2);
}

test fn map_get_miss_returns_none() -> Unit {
    let m: Map[String, Int] = {"one": 1, "two": 2};
    let v: Int = match m.get("nine") {
        Some(n) => n,
        None => -1,
    };
    assert_eq(v, -1);
}

test fn map_insert_grows_map() -> Unit {
    let m: ref Map[String, Int] = {"seed": 0};
    m.insert("a", 10);
    m.insert("b", 20);
    m.insert("c", 30);
    assert_eq(m.len(), 4);
    assert_eq(m.get("b").unwrap_or(-1), 20);
}

test fn map_insert_overwrites_existing_key() -> Unit {
    let m: ref Map[String, Int] = {"k": 1};
    m.insert("k", 99);
    assert_eq(m.len(), 1);
    assert_eq(m.get("k").unwrap_or(-1), 99);
}

test fn map_contains_key() -> Unit {
    let m: Map[String, Int] = {"x": 1, "y": 2};
    assert_eq(m.contains_key("x"), true);
    assert_eq(m.contains_key("z"), false);
}

// String values are boxed `*MvlString` handles under the WASM backend
// (#2047) — `.get()` must clone before returning so the caller's
// `unwrap_or` cleanup doesn't free memory the map's own entry still
// references. `contains_key`/`len`/`main` here also just exercise that the
// map itself survives being fully consumed afterward.
test fn map_string_value_get_hit_returns_some() -> Unit {
    let m: Map[String, String] = {"status": "ready"};
    let v: String = m.get("status").unwrap_or("none");
    assert_eq(v, "ready");
}

test fn map_string_value_get_miss_returns_none() -> Unit {
    let m: Map[String, String] = {"status": "ready"};
    let v: String = m.get("missing").unwrap_or("none");
    assert_eq(v, "none");
}

test fn map_string_value_get_twice_is_safe() -> Unit {
    let m: Map[String, String] = {"status": "ready"};
    let first: String = m.get("status").unwrap_or("none");
    let second: String = m.get("status").unwrap_or("none");
    assert_eq(first, "ready");
    assert_eq(second, "ready");
}
