// 05_collections/list_string_ops_wasm_gaps_test.mvl — split from
// list_string_ops_test.mvl (#2262): four `List[String]` operations that
// failed under `--backend=wasm` for reasons unrelated to that file's
// `skip`/`take`/`slice` fix — found only while confirming the whole file
// passes end-to-end (not just compiles) after it. All four now pass
// (#2271).
//
// `list_string_contains`: `List[T]::contains(x)`'s WASM dispatch picked
// `_mvl_array_contains_i32` or `_mvl_array_contains_i64` based on
// `is_i32(&elem_ty, ctx)`, with no case for `String` at all — fixed by a
// dedicated `_mvl_array_contains_str` dispatch arm.
//
// `list_string_any`: `xs.any(|s: String| s == "a")` — a string literal
// referenced only inside a closure body (not elsewhere in an
// already-scanned fn) was never interned by `collect_literals`'s
// pre-pass, which didn't recurse into `TirExprKind::Lambda` bodies at all
// — those are emitted later, as their own top-level `$__lambda_…` fn, by
// `emit_lambda_fns`. The use site then emitted `;; missing literal`, a
// stack-underflow module `wasm-tools parse` accepts but `validate`
// rejects. Fixed by adding a `Lambda` arm to `collect_expr`.
//
// `list_string_min`/`list_string_max`: WASM had zero native dispatch for
// `.min()`/`.max()`, so every call monomorphized `std/lists.mvl`'s
// documented fallback body (`self.first()`/`self.last()`, not a true
// min/max — see that file's own doc comment). Fixed by native WASM
// min/max dispatch mirroring the LLVM backend's
// `_mvl_list_min_index_str`/`_mvl_list_max_index_str`.

test fn list_string_contains() -> Unit {
    let xs: List[String] = ["bb", "a", "ccc"];
    assert_eq(xs.contains("a"), true);
    assert_eq(xs.contains("zzz"), false)
}

test fn list_string_any() -> Unit {
    let xs: List[String] = ["bb", "a", "ccc"];
    assert_eq(xs.any(|s: String| s == "a"), true);
    assert_eq(xs.any(|s: String| s == "zzz"), false)
}

test fn list_string_min() -> Unit {
    let xs: List[String] = ["bb", "a", "ccc"];
    assert_eq(xs.min().unwrap_or("?"), "a")
}

test fn list_string_max() -> Unit {
    let xs: List[String] = ["bb", "a", "ccc"];
    assert_eq(xs.max().unwrap_or("?"), "ccc")
}
