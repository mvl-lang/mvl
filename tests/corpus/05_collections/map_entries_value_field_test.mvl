// 05_collections/map_entries_value_field_test.mvl — split from
// map_hof_test.mvl (#2251).
//
// `Entry[K, V]`'s LLVM struct type used to hardcode `ptr` for a generic
// field regardless of the concrete instantiation (`Entry[String, Int]`'s
// `value` field was declared `ptr` instead of `i64`) — the same generic-
// struct-field-layout gap still tracked for `list_stubs_test.mvl` (#2119's
// LLVM remainder, a broader set of gaps this fix doesn't touch). Fixed
// (#2270) by mangling a distinct named type per concrete instantiation
// (`%Entry__String_Int`) the first time it's constructed/read/bound,
// mirroring the existing per-call-site monomorphization for generic
// *functions*. No longer excluded from `--backend=llvm`; passes on
// `--backend=rust`/`wasm` as before.

use std.collections.{Entry}

test fn map_entries_sum_of_values() -> Unit {
    let m: Map[String, Int] = {"a": 1, "b": 2, "c": 3};
    let es: List[Entry[String, Int]] = m.entries();
    let sum: Int = es.fold(0, |acc: Int, e: Entry[String, Int]| acc + e.value);
    assert_eq(sum, 6);
}
