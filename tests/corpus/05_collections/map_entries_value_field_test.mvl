// 05_collections/map_entries_value_field_test.mvl — split from
// map_hof_test.mvl (#2251).
//
// `Entry[K, V]`'s LLVM struct type hardcodes `ptr` for a generic field
// regardless of the concrete instantiation (`Entry[String, Int]`'s `value`
// field is declared `ptr` instead of `i64`) — the same generic-struct-
// field-layout gap already tracked for `list_stubs_test.mvl` (#2119's LLVM
// remainder: "a generic struct's field layout... resolved the struct's own
// declaration-time type-param name instead of the concrete type at the
// call site"). Reading `.value` off an `Entry[String, Int]` — with or
// without going through a HOF closure — hits an LLVM type mismatch
// (`ptr` where `i64` is expected) and fails to compile under
// `--backend=llvm`. Excluded there via `LLVM_CORPUS_EXCLUDE` until that
// struct-layout fix lands; passes on `--backend=rust`/`wasm`.

use std.collections.{Entry}

test fn map_entries_sum_of_values() -> Unit {
    let m: Map[String, Int] = {"a": 1, "b": 2, "c": 3};
    let es: List[Entry[String, Int]] = m.entries();
    let sum: Int = es.fold(0, |acc: Int, e: Entry[String, Int]| acc + e.value);
    assert_eq(sum, 6);
}
