// 05_collections/set_test.mvl — Set[T] construction, membership, insertion.
//
// Literal syntax: `{1, 2, 3}` — bare braces with values (contrast Map:
// `{"k": v}` uses key: value pairs). Empty set via `Set::new()` is
// skipped for now — same LLVM ::-in-symbol issue as Map (#1842).

test fn set_literal_and_len() -> Unit {
    let s: Set[Int] = {1, 2, 3, 4};
    assert_eq(s.len(), 4);
}

test fn set_dedupes_on_construction() -> Unit {
    let s: Set[Int] = {1, 2, 2, 3, 3, 3};
    assert_eq(s.len(), 3);
}

test fn set_contains_hit() -> Unit {
    let s: Set[Int] = {10, 20, 30};
    assert_eq(s.contains(20), true);
}

test fn set_contains_miss() -> Unit {
    let s: Set[Int] = {10, 20, 30};
    assert_eq(s.contains(99), false);
}

test fn set_insert_new_element() -> Unit {
    let s: ref Set[Int] = {1, 2, 3};
    s.insert(4);
    assert_eq(s.len(), 4);
    assert_eq(s.contains(4), true);
}

test fn set_insert_existing_element_noop() -> Unit {
    let s: ref Set[Int] = {1, 2, 3};
    s.insert(2);
    assert_eq(s.len(), 3);
}

test fn set_remove_existing_element() -> Unit {
    let s: ref Set[Int] = {1, 2, 3};
    s.remove(2);
    assert_eq(s.len(), 2);
    assert_eq(s.contains(2), false);
    assert_eq(s.contains(1), true);
}

test fn set_remove_missing_element_noop() -> Unit {
    let s: ref Set[Int] = {1, 2, 3};
    s.remove(99);
    assert_eq(s.len(), 3);
}

test fn set_map_transforms_and_dedups() -> Unit {
    let s: Set[Int] = {1, 2, 3};
    let doubled: Set[Int] = s.map(|x: Int| x * 2);
    assert_eq(doubled.len(), 3);
    assert_eq(doubled.contains(2), true);
    assert_eq(doubled.contains(4), true);
    assert_eq(doubled.contains(6), true);
    // Original untouched.
    assert_eq(s.len(), 3);
}

test fn set_map_collapses_collisions() -> Unit {
    let s: Set[Int] = {1, 2, 3, 4};
    let parity: Set[Int] = s.map(|x: Int| x % 2);
    assert_eq(parity.len(), 2);
    assert_eq(parity.contains(0), true);
    assert_eq(parity.contains(1), true);
}

// TODO: `Set[String].contains(literal)` fails in the Rust transpiler with an
// ambiguous `.into()` target — pending a separate ticket. Set[Int] covers the
// key-lookup path meanwhile.

// #2131: `to_list`/`intersection`/`difference`/`union`/`filter`/`fold`/`any`/
// `all` were blocked by `std/collections.mvl` not being loaded into the
// implicit prelude for codegen (backends never saw these methods' real MVL
// bodies, only their self-referential stubs). Covers all three backends.

test fn set_to_list_returns_all_elements() -> Unit {
    let s: Set[Int] = {1, 2, 3};
    let l: List[Int] = s.to_list();
    assert_eq(l.len(), 3);
}

test fn set_intersection_keeps_shared_elements() -> Unit {
    let a: Set[Int] = {1, 2, 3};
    let b: Set[Int] = {2, 3, 4};
    let i: Set[Int] = a.intersection(b);
    assert_eq(i.len(), 2);
    assert_eq(i.contains(2), true);
    assert_eq(i.contains(3), true);
    assert_eq(i.contains(1), false);
}

test fn set_difference_keeps_elements_not_in_other() -> Unit {
    let a: Set[Int] = {1, 2, 3};
    let b: Set[Int] = {2, 3};
    let d: Set[Int] = a.difference(b);
    assert_eq(d.len(), 1);
    assert_eq(d.contains(1), true);
}

test fn set_union_combines_both_sets() -> Unit {
    let a: Set[Int] = {1, 2};
    let b: Set[Int] = {2, 3};
    let u: Set[Int] = a.union(b);
    assert_eq(u.len(), 3);
    assert_eq(u.contains(1), true);
    assert_eq(u.contains(3), true);
}

test fn set_filter_retains_matching_elements() -> Unit {
    let s: Set[Int] = {1, 2, 3, 4};
    let evens: Set[Int] = s.filter(|x: Int| x % 2 == 0);
    assert_eq(evens.len(), 2);
    assert_eq(evens.contains(2), true);
    assert_eq(evens.contains(1), false);
}

test fn set_fold_sums_elements() -> Unit {
    let s: Set[Int] = {1, 2, 3};
    let sum: Int = s.fold(0, |acc: Int, x: Int| acc + x);
    assert_eq(sum, 6);
}

test fn set_any_true_when_one_matches() -> Unit {
    let s: Set[Int] = {1, 2, 3};
    assert_eq(s.any(|x: Int| x > 2), true);
}

test fn set_any_false_when_none_match() -> Unit {
    let s: Set[Int] = {1, 2, 3};
    assert_eq(s.any(|x: Int| x > 5), false);
}

test fn set_all_true_when_all_match() -> Unit {
    let s: Set[Int] = {1, 2, 3};
    assert_eq(s.all(|x: Int| x > 0), true);
}

test fn set_all_false_when_one_fails() -> Unit {
    let s: Set[Int] = {1, 2, 3};
    assert_eq(s.all(|x: Int| x > 1), false);
}

// #2124: `let alias: ref Set[Int] = original;` used to lower to a bare
// `local.set` — a pointer alias, not a value copy. Mutating through `alias`
// silently corrupted `original` too. `std/config.mvl`'s `merge` and
// `std/pbt.mvl`'s shrink loop both rely on this exact shape (`let out: ref
// T = base;`) expecting `base` to stay untouched.
test fn ref_let_binding_from_existing_set_does_not_alias_source() -> Unit {
    let original: Set[Int] = {1, 2, 3};
    let alias: ref Set[Int] = original;
    alias.insert(99);
    assert_eq(original.len(), 3);
    assert_eq(original.contains(99), false);
    assert_eq(alias.len(), 4);
    assert_eq(alias.contains(99), true);
}
