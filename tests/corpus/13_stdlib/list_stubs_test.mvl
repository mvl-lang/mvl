// 13_stdlib/list_stubs_test.mvl — List[T] methods with no native WASM
// dispatch arm before #2119. `mvl build --backend=wasm` silently
// monomorphized these to `unreachable` and exited 0 unless something
// actually called them (#2014) — this file is that call, run through
// every backend by the corpus runner so a regression fails loudly.
//
// Covers: set, windows, chunks, extend, filled, enumerate, zip,
// partition, group_by.

fn is_even(x: Int) -> Bool { x % 2 == 0 }

// ── set ─────────────────────────────────────────────────────────────────────

test fn set_replaces_element() -> Unit {
    let xs: ref List[Int] = [1, 2, 3];
    xs.set(1, 99);
    assert_eq(xs.get(1).unwrap_or(0), 99);
    assert_eq(xs.len(), 3)
}

// ── windows ─────────────────────────────────────────────────────────────────

test fn windows_basic() -> Unit {
    let xs: List[Int] = [1, 2, 3, 4, 5];
    let wins: List[List[Int]] = xs.windows(3);
    assert_eq(wins.len(), 3);
    assert_eq(wins.get(0).unwrap_or([]).len(), 3)
}

// ── chunks ──────────────────────────────────────────────────────────────────

test fn chunks_uneven_split() -> Unit {
    let xs: List[Int] = [1, 2, 3, 4, 5];
    let ch: List[List[Int]] = xs.chunks(2);
    assert_eq(ch.len(), 3);
    assert_eq(ch.get(2).unwrap_or([]).len(), 1)
}

// ── extend ──────────────────────────────────────────────────────────────────

test fn extend_appends_all() -> Unit {
    let xs: ref List[Int] = [1, 2];
    xs.extend([3, 4, 5]);
    assert_eq(xs.len(), 5);
    assert_eq(xs.get(4).unwrap_or(0), 5)
}

test fn extend_with_empty() -> Unit {
    let xs: ref List[Int] = [1, 2];
    let empty: List[Int] = [];
    xs.extend(empty);
    assert_eq(xs.len(), 2)
}

// ── filled ──────────────────────────────────────────────────────────────────

test fn filled_creates_n_copies() -> Unit {
    let xs: List[Int] = List[Int]::filled(4, 7);
    assert_eq(xs.len(), 4);
    assert_eq(xs.get(0).unwrap_or(0), 7);
    assert_eq(xs.get(3).unwrap_or(0), 7)
}

test fn filled_zero_length() -> Unit {
    let xs: List[Int] = List[Int]::filled(0, 7);
    assert_eq(xs.len(), 0)
}

// ── enumerate ───────────────────────────────────────────────────────────────

test fn enumerate_pairs_index_and_value() -> Unit {
    let xs: List[String] = ["a", "b", "c"];
    let indexed: List[Indexed[String]] = xs.enumerate();
    assert_eq(indexed.len(), 3);
    match indexed.get(1) {
        Some(pair) => {
            assert_eq(pair.index, 1);
            assert_eq(pair.value, "b")
        },
        None => assert(false),
    }
}

test fn enumerate_empty() -> Unit {
    let xs: List[Int] = [];
    let indexed: List[Indexed[Int]] = xs.enumerate();
    assert_eq(indexed.len(), 0)
}

// ── zip ─────────────────────────────────────────────────────────────────────

test fn zip_pairs_by_position() -> Unit {
    let xs: List[Int] = [1, 2, 3];
    let ys: List[String] = ["a", "b", "c"];
    let zipped: List[Pair[Int, String]] = xs.zip(ys);
    assert_eq(zipped.len(), 3);
    match zipped.get(0) {
        Some(pair) => {
            assert_eq(pair.first, 1);
            assert_eq(pair.second, "a")
        },
        None => assert(false),
    }
}

test fn zip_stops_at_shorter_list() -> Unit {
    let xs: List[Int] = [1, 2, 3, 4];
    let ys: List[Int] = [10, 20];
    let zipped: List[Pair[Int, Int]] = xs.zip(ys);
    assert_eq(zipped.len(), 2)
}

// ── partition ───────────────────────────────────────────────────────────────

test fn partition_splits_evens_odds() -> Unit {
    let xs: List[Int] = [1, 2, 3, 4, 5, 6];
    let result: Partitioned[Int] = xs.partition(is_even);
    assert_eq(result.matching.len(), 3);
    assert_eq(result.rest.len(), 3)
}

// ── group_by ────────────────────────────────────────────────────────────────
//
// String key only — WASM's `Map` runtime (`_mvl_map_*_si64`) supports String
// keys exclusively; `Map[Int, V]` is a separate, pre-existing gap (no corpus
// file has ever exercised a non-String-keyed Map under WASM) and out of
// scope for #2119's List-method coverage.

fn parity_label(x: Int) -> String {
    if x % 2 == 0 { "even" } else { "odd" }
}

test fn group_by_parity() -> Unit {
    let xs: List[Int] = [1, 2, 3, 4, 5, 6];
    let groups: Map[String, List[Int]] = xs.group_by(parity_label);
    assert_eq(groups.len(), 2)
}
