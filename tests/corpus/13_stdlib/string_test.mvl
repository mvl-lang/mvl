// 13_stdlib/string_test.mvl — String extension methods.
//
// Covers the portable subset of `std/strings.mvl` that both backends lower
// via runtime shims: `.len`, `.concat`, `.substring`, `.to_upper`,
// `.to_lower`, `.starts_with`, `.ends_with`, `.contains`, `.is_empty`,
// `.trim`, `.chars`, `.char_at`, `.byte_at`, `String::from_chars`, and
// `String::from_bytes`. The methods are dispatched via dot syntax as
// type-attached methods (ADR-0031 amendment), not general UFCS.

test fn string_len() -> Unit {
    assert_eq("hello".len(), 5);
    assert_eq("".len(), 0);
    assert_eq("abcdefghij".len(), 10);
}

test fn string_concat() -> Unit {
    assert_eq("hello".concat(" world"), "hello world");
    assert_eq("".concat("x"), "x");
    assert_eq("x".concat(""), "x");
}

test fn string_substring() -> Unit {
    assert_eq("hello world".substring(0, 5), "hello");
    assert_eq("hello world".substring(6, 11), "world");
    assert_eq("hello".substring(1, 4), "ell");
}

test fn string_case_conversion() -> Unit {
    assert_eq("HELLO".to_lower(), "hello");
    assert_eq("hello".to_upper(), "HELLO");
    assert_eq("Mixed Case".to_lower(), "mixed case");
    assert_eq("Mixed Case".to_upper(), "MIXED CASE");
}

test fn string_starts_and_ends_with() -> Unit {
    assert_eq("hello world".starts_with("hello"), true);
    assert_eq("hello world".starts_with("world"), false);
    assert_eq("hello world".ends_with("world"), true);
    assert_eq("hello world".ends_with("hello"), false);
    assert_eq("hello".starts_with(""), true);
    assert_eq("hello".ends_with(""), true);
}

test fn string_contains() -> Unit {
    assert_eq("hello world".contains("world"), true);
    assert_eq("hello world".contains("planet"), false);
    assert_eq("hello".contains("hello"), true);
    assert_eq("hello".contains(""), true);
}

test fn string_is_empty() -> Unit {
    assert_eq("".is_empty(), true);
    assert_eq("x".is_empty(), false);
    assert_eq(" ".is_empty(), false);
}

test fn string_trim() -> Unit {
    assert_eq("  hello  ".trim(), "hello");
    assert_eq("hello".trim(), "hello");
    assert_eq("".trim(), "");
    assert_eq("   ".trim(), "");
}

// #2121 — `.chars()` had no WASM emitter arm at all.
test fn string_chars() -> Unit {
    let empty: List[String] = "".chars();
    assert_eq(empty.len(), 0);

    let cs: List[String] = "abc".chars();
    assert_eq(cs.len(), 3);
    assert_eq(cs.get(0).unwrap_or(""), "a");
    assert_eq(cs.get(1).unwrap_or(""), "b");
    assert_eq(cs.get(2).unwrap_or(""), "c");

    // Non-ASCII: code-point iteration, not byte iteration (#2121 acceptance).
    let unicode: List[String] = "héllo".chars();
    assert_eq(unicode.len(), 5);
    assert_eq(unicode.get(1).unwrap_or(""), "é");
}

// #2175 — `.char_at()` had no WASM emitter arm at all.
test fn string_char_at() -> Unit {
    assert_eq("abc".char_at(1).unwrap_or(""), "b");
    assert_eq("abc".char_at(0).unwrap_or(""), "a");
    assert_eq("abc".char_at(2).unwrap_or(""), "c");

    match "abc".char_at(5) {
        Some(_) => assert_eq(true, false),
        None => assert_eq(true, true),
    }
    match "abc".char_at(-1) {
        Some(_) => assert_eq(true, false),
        None => assert_eq(true, true),
    }

    // Non-ASCII: code-point index, not byte index.
    assert_eq("héllo".char_at(1).unwrap_or(""), "é");
}

// #2123 — `.byte_at()` had no WASM emitter arm at all.
test fn string_byte_at() -> Unit {
    assert_eq("hi".byte_at(0).unwrap_or(from_int(0)).to_int(), 104);
    assert_eq("hi".byte_at(1).unwrap_or(from_int(0)).to_int(), 105);

    match "hi".byte_at(10) {
        Some(_) => assert_eq(true, false),
        None => assert_eq(true, true),
    }
    match "hi".byte_at(-1) {
        Some(_) => assert_eq(true, false),
        None => assert_eq(true, true),
    }
}

// #2123 — `String::from_chars()` had no WASM emitter arm at all (a static
// qualified call, not a `MethodCall` — it built with zero warnings but
// emitted a call to an undeclared symbol).
test fn string_from_chars() -> Unit {
    let s: String = String::from_chars(["a", "b", "c"]);
    assert_eq(s, "abc");

    let empty: String = String::from_chars([]);
    assert_eq(empty, "");

    // Non-ASCII chars round-trip too.
    let unicode: String = String::from_chars(["h", "é", "l", "l", "o"]);
    assert_eq(unicode, "héllo");
}

// #2123 — `String::from_bytes()` had no WASM emitter arm at all (same
// silent-failure shape as `from_chars`).
test fn string_from_bytes() -> Unit {
    let bytes: List[Byte] = [from_int(72), from_int(105)];
    let s: String = String::from_bytes(bytes);
    assert_eq(s, "Hi");

    let empty: String = String::from_bytes([]);
    assert_eq(empty, "");

    // byte_at/from_bytes roundtrip for every byte 0..=255 (#1487).
    let roundtrip: String = String::from_bytes([from_int(0), from_int(255)]);
    assert_eq(roundtrip.byte_at(0).unwrap_or(from_int(99)).to_int(), 0);
    assert_eq(roundtrip.byte_at(1).unwrap_or(from_int(99)).to_int(), 255);
}

// A `.concat()` result returned directly from a fn (no intermediate `let`)
// used to be use-after-freed under the WASM backend: the fn's own
// return-path drop sweep freed the `*MvlString` buffer it had just computed,
// before the caller ever read the `(ptr, len)` pair (#2023).
type Greeting = enum { Hello, Goodbye }

fn combine(a: String, b: String) -> String {
    a.concat(b)
}

fn greeting_word(g: Greeting) -> String {
    match g {
        Greeting::Hello => "hello",
        Greeting::Goodbye => "goodbye",
    }
}

// Chains a second helper's return value straight into `.concat()` — the
// receiver is itself a call result, not a literal (#2052).
fn greet(g: Greeting, name: String) -> String {
    greeting_word(g).concat(name)
}

test fn string_method_result_survives_direct_return() -> Unit {
    assert_eq(combine("hello", "world"), "helloworld");
}

test fn string_method_result_survives_chained_helper_return() -> Unit {
    assert_eq(greet(Greeting::Hello, ", world"), "hello, world");
    assert_eq(greet(Greeting::Goodbye, ", world"), "goodbye, world");
}

// A `.concat()` result bound to an intermediate `let` before being returned
// used to be use-after-freed too, one level removed from #2023: `return s`
// only ever protected the name `s`, which is never itself drop-tracked (it's
// a split `s_ptr`/`s_len` pair) — the real heap owner is the `*MvlString`
// temp the concat call materialized, and the fn's return-path drop sweep
// still freed that buffer before the caller read it.
fn combine_via_let(a: String, b: String) -> String {
    let s: String = a.concat(b);
    return s;
}

test fn string_method_result_survives_let_bound_return() -> Unit {
    assert_eq(combine_via_let("hello", "world"), "helloworld");
}
