// parser.mvl — JSON log parsing module.
//
// Demonstrates:
//   1. std.json — pure MVL JSON parsing, zero extern trust boundary
//   2. IFC labels: Tainted input → sanitize → String
//   3. Total functions with exhaustive match (Req 8, Req 3)
//   4. Phase 4: Result.and_then / Result.map replace ? operator chains
//   5. Phase 4: std.string.to_lower for case-insensitive level matching
//   6. Phase 4: List[LogEntry] pipeline — filter → map → fold
//
// No extern block: JSON decode/encode is native MVL (std.json), added
// after this example was first written — this module used to bridge to
// serde_json via `extern "rust"`.

use std.json.{Value, decode, encode}
use std.collections.{Map}

// ── Domain types ───────────────────────────────────────────────────────────

pub type ParseError = enum {
    InvalidJson,
    UnknownLevel,
    MissingField,
}

/// Log severity level for a parsed log entry.
pub type Severity = enum {
    Debug,
    Info,
    Warn,
    Error,
}

// Raw deserialized entry — fields arrive as Tainted from serde.
type RawEntry = struct {
    level:     Tainted[String],
    message:   Tainted[String],
    timestamp: Int,
}

/// Validated log entry with sanitized message text.
pub type LogEntry = struct {
    level:     Severity,
    message:   String,
    timestamp: Int,
}

/// Aggregated report — field 'count' (not 'total': reserved keyword).
pub type Report = struct {
    count:    Int,
    errors:   Int,
    warnings: Int,
    infos:    Int,
}

// ── MVL-verified parsing logic ─────────────────────────────────────────────

/// Parse a log level string, case-insensitively (uses `to_lower`).
/// "ERROR", "Error", and "error" all resolve to `Severity::Error`.
pub total fn parse_level(raw: Tainted[String]) -> Result[Severity, ParseError] {
    let clean: String = relabel trust(raw, "VALIDATED");
    let lower: String = clean.to_lower();
    match lower {
        "debug" => Ok(Severity::Debug),
        "info"  => Ok(Severity::Info),
        "warn"  => Ok(Severity::Warn),
        "error" => Ok(Severity::Error),
        _       => Err(ParseError::UnknownLevel),
    }
}

/// Parse `{"level": ..., "message": ..., "timestamp": ...}` into a
/// `RawEntry` using the pure-MVL `std.json` decoder — the JSON *structure*
/// (braces, colons, quoting) is public syntax, but the field VALUES
/// extracted from it are re-tainted immediately, preserving the same
/// "Tainted until sanitized" boundary a `serde_json` extern would enforce.
// Two sequential matches rather than one nested pattern with a sibling
// wildcard (`Err(_) => ..., Ok(Value::Object(o)) => ..., Ok(_) => ...`) —
// that shape hits an LLVM backend bug where both `Ok(...)` arms lower to
// the same switch-case discriminant (`i8 0`), producing a `.ll` module
// with a duplicate case value that `lli` rejects outright. Filed for the
// compiler; this is the workaround.
partial fn parse_raw_entry(raw: Tainted[String]) -> Result[RawEntry, ParseError] {
    let json_str: String = relabel trust(raw, "JSON-STRUCTURE");
    match decode(json_str) {
        Err(_)     => Err(ParseError::InvalidJson),
        Ok(parsed) => match parsed {
            Value::Object(o) => raw_entry_from_fields(o),
            _                => Err(ParseError::InvalidJson),
        },
    }
}

// `get_string_field`/`get_number_field` deliberately split the lookup into
// two sequential matches (`Option[Value]`, then `Value`'s own variant)
// rather than one nested pattern `Some(Value::String(x)) => x`. The nested
// form hits a WASM backend bug — the String binding's `$name_ptr`/`$name_len`
// locals go undeclared, and the whole function fails to assemble
// (`unknown local: failed to find name`). Filed for the compiler; this is
// the workaround.
fn get_string_field(fields: Map[String, Value], key: String) -> Option[String] {
    match fields.get(key) {
        None    => None,
        Some(v) => match v {
            Value::String(s) => Some(s),
            _                => None,
        },
    }
}

fn get_number_field(fields: Map[String, Value], key: String) -> Option[Float] {
    match fields.get(key) {
        None    => None,
        Some(v) => match v {
            Value::Number(n) => Some(n),
            _                => None,
        },
    }
}

fn raw_entry_from_fields(fields: Map[String, Value]) -> Result[RawEntry, ParseError] {
    match get_string_field(fields, "level") {
        None            => Err(ParseError::MissingField),
        Some(raw_level) => raw_entry_with_level(fields, raw_level),
    }
}

fn raw_entry_with_level(fields: Map[String, Value], raw_level: String) -> Result[RawEntry, ParseError] {
    match get_string_field(fields, "message") {
        None           => Err(ParseError::MissingField),
        Some(message)  => raw_entry_with_message(fields, raw_level, message),
    }
}

fn raw_entry_with_message(
    fields: Map[String, Value],
    raw_level: String,
    message: String,
) -> Result[RawEntry, ParseError] {
    match get_number_field(fields, "timestamp") {
        None     => Err(ParseError::MissingField),
        Some(ts) => Ok(RawEntry {
            level:     relabel taint(raw_level, "JSON-FIELD-LEVEL"),
            message:   relabel taint(message, "JSON-FIELD-MESSAGE"),
            timestamp: ts.to_int(),
        }),
    }
}

/// Parse a single JSON log line — external input stays Tainted until sanitized.
/// The `?` operator short-circuits on `Err`, equivalent to `.and_then()` chaining.
pub partial fn parse_line(raw: Tainted[String]) -> Result[LogEntry, ParseError] {
    let entry: RawEntry = parse_raw_entry(raw)?;
    let level: Severity = parse_level(entry.level)?;
    Ok(LogEntry {
        level:     level,
        message:   relabel trust(entry.message, "VALIDATED"),
        timestamp: entry.timestamp,
    })
}

/// Parse every line of `content` into a `LogEntry`, silently skipping blank
/// lines and lines that fail to parse (malformed JSON, a missing field, or
/// an unrecognized level) — a single corrupt record in a JSONL stream
/// should not block analysis of the rest.
pub partial fn parse_lines(content: Tainted[String]) -> List[LogEntry] {
    let lines: List[String] = relabel trust(content, "JSON-STRUCTURE").split("\n");
    let out: ref List[LogEntry] = [];
    for i in range(0, lines.len()) {
        let line: String = lines.get(i).unwrap_or("").trim();
        if line.len() > 0 {
            match parse_line(relabel taint(line, "JSON-LINE")) {
                Ok(entry) => out.push(entry),
                Err(_)    => {},
            }
        } else {
        }
    }
    out
}

/// True iff `level`'s parsed `Severity` matches `wanted` (case-insensitive
/// against the CLI's `--level` argument).
fn severity_matches(level: Severity, wanted_lower: String) -> Bool {
    match level {
        Severity::Error => wanted_lower == "error",
        Severity::Warn  => wanted_lower == "warn",
        Severity::Info  => wanted_lower == "info",
        Severity::Debug => wanted_lower == "debug",
    }
}

/// Retain only entries whose severity matches `level` (case-insensitive).
///
/// An explicit loop rather than `entries.filter(|e| ...)` — that predicate
/// would need to capture `level: String`, and the WASM backend's closure
/// support is currently scoped to scalar captures only (#2118).
pub total fn filter_by_level(entries: List[LogEntry], wanted_level: String) -> List[LogEntry] {
    let wanted: String = wanted_level.to_lower();
    let out: ref List[LogEntry] = [];
    for i in range(0, entries.len()) {
        match entries.get(i) {
            None    => {},
            Some(e) => {
                if severity_matches(e.level, wanted) {
                    out.push(e)
                } else {
                }
            },
        }
    }
    out
}

/// Serialise a `Report` to a JSON string for output, via `std.json.encode`.
pub partial fn report_to_json(report: Report) -> String {
    let fields: ref Map[String, Value] = Map[String, Value]::new();
    fields.insert("count", Value::Number(report.count.to_float()));
    fields.insert("errors", Value::Number(report.errors.to_float()));
    fields.insert("warnings", Value::Number(report.warnings.to_float()));
    fields.insert("infos", Value::Number(report.infos.to_float()));
    encode(Value::Object(fields))
}

// ── Phase 4 List[LogEntry] pipeline ───────────────────────────────────────

/// Build an aggregated `Report` from a list of parsed log entries.
/// Each entry increments the appropriate counter by level.
pub total fn build_report(entries: List[LogEntry]) -> Report {
    entries.fold(
        Report { count: 0, errors: 0, warnings: 0, infos: 0 },
        |acc: Report, entry: LogEntry| match entry.level {
            Severity::Error => Report {
                count: acc.count + 1, errors: acc.errors + 1,
                warnings: acc.warnings, infos: acc.infos
            },
            Severity::Warn  => Report {
                count: acc.count + 1, errors: acc.errors,
                warnings: acc.warnings + 1, infos: acc.infos
            },
            Severity::Info  => Report {
                count: acc.count + 1, errors: acc.errors,
                warnings: acc.warnings, infos: acc.infos + 1
            },
            Severity::Debug => Report {
                count: acc.count + 1, errors: acc.errors,
                warnings: acc.warnings, infos: acc.infos
            },
        }
    )
}

/// Summarize a log entry as a human-readable string for map → display pipeline.
pub total fn entry_summary(entry: LogEntry) -> String {
    match entry.level {
        Severity::Error => "ERROR",
        Severity::Warn  => "WARN",
        Severity::Info  => "INFO",
        Severity::Debug => "DEBUG",
    }
}

/// Predicate: true iff the entry is an error-level log entry.
/// Used as a named filter argument: `entries.filter(is_error_level)`.
pub total fn is_error_level(entry: LogEntry) -> Bool {
    match entry.level {
        Severity::Error => true,
        Severity::Warn  => false,
        Severity::Info  => false,
        Severity::Debug => false,
    }
}

// ── Internal unit tests ────────────────────────────────────────────────────
// A bare String literal is NOT compatible with a Tainted[String] parameter —
// labeled and unlabeled types are distinct, no implicit coercion either
// direction (checker/types.rs's `types_compatible`, #894). Each call below
// makes the taint explicit via `relabel taint(...)`.

test fn check_debug_level_is_ok() -> Unit {
    let result: Result[Severity, ParseError] = parse_level(relabel taint("debug", "TEST-DEBUG"));
    let ok: Int = match result {
        Ok(_)  => 1,
        Err(_) => 0,
    };
    assert_eq(ok, 1);
}

test fn check_error_level_is_ok() -> Unit {
    let result: Result[Severity, ParseError] = parse_level(relabel taint("error", "TEST-ERROR"));
    let ok: Int = match result {
        Ok(_)  => 1,
        Err(_) => 0,
    };
    assert_eq(ok, 1);
}

// to_lower() enables case-insensitive level parsing (Phase 4).
test fn check_uppercase_error_level_is_ok() -> Unit {
    let result: Result[Severity, ParseError] = parse_level(relabel taint("ERROR", "TEST-UPPERCASE"));
    let ok: Int = match result {
        Ok(_)  => 1,
        Err(_) => 0,
    };
    assert_eq(ok, 1);
}

test fn check_unknown_level_is_err() -> Unit {
    let result: Result[Severity, ParseError] = parse_level(relabel taint("verbose", "TEST-UNKNOWN"));
    let err: Int = match result {
        Ok(_)  => 0,
        Err(_) => 1,
    };
    assert_eq(err, 1);
}

test fn check_empty_level_is_err() -> Unit {
    let result: Result[Severity, ParseError] = parse_level(relabel taint("", "TEST-EMPTY"));
    let err: Int = match result {
        Ok(_)  => 0,
        Err(_) => 1,
    };
    assert_eq(err, 1);
}

// ── build_report pipeline tests ───────────────────────────────────────────

test fn build_report_empty_list_is_zero() -> Unit {
    let entries: List[LogEntry] = [];
    let report: Report = build_report(entries);
    assert_eq(report.count, 0);
}

test fn build_report_counts_total() -> Unit {
    let entries: List[LogEntry] = [
        LogEntry { level: Severity::Info,  message: "msg1", timestamp: 1 },
        LogEntry { level: Severity::Error, message: "msg2", timestamp: 2 },
        LogEntry { level: Severity::Warn,  message: "msg3", timestamp: 3 },
    ];
    let report: Report = build_report(entries);
    assert_eq(report.count, 3);
}

test fn build_report_counts_errors() -> Unit {
    let entries: List[LogEntry] = [
        LogEntry { level: Severity::Error, message: "e1", timestamp: 1 },
        LogEntry { level: Severity::Error, message: "e2", timestamp: 2 },
        LogEntry { level: Severity::Info,  message: "i1", timestamp: 3 },
    ];
    let report: Report = build_report(entries);
    assert_eq(report.errors, 2);
}

test fn build_report_counts_warnings() -> Unit {
    let entries: List[LogEntry] = [
        LogEntry { level: Severity::Warn, message: "w1", timestamp: 1 },
        LogEntry { level: Severity::Warn, message: "w2", timestamp: 2 },
    ];
    let report: Report = build_report(entries);
    assert_eq(report.warnings, 2);
}

test fn build_report_counts_infos() -> Unit {
    let entries: List[LogEntry] = [
        LogEntry { level: Severity::Info,  message: "i1", timestamp: 1 },
        LogEntry { level: Severity::Debug, message: "d1", timestamp: 2 },
    ];
    let report: Report = build_report(entries);
    assert_eq(report.infos, 1);
}

// Phase 4 pipeline: filter by level → map to summary → fold to count.
// Uses is_error_level predicate (named filter) and verifies that
// entry_summary produces "ERROR" strings (map output is observed).
test fn pipeline_filter_map_fold_error_count() -> Unit {
    let entries: List[LogEntry] = [
        LogEntry { level: Severity::Info,  message: "i1", timestamp: 1 },
        LogEntry { level: Severity::Error, message: "e1", timestamp: 2 },
        LogEntry { level: Severity::Error, message: "e2", timestamp: 3 },
        LogEntry { level: Severity::Warn,  message: "w1", timestamp: 4 },
    ];
    // fold observes the string values from entry_summary to verify the map step.
    let error_count: Int = entries
        .filter(is_error_level)
        .map(entry_summary)
        .fold(0, |acc: Int, s: String| {
            let is_error_str: Int = match s { "ERROR" => 1, _ => 0 };
            acc + is_error_str
        });
    assert_eq(error_count, 2);
}

// ── entry_summary tests ───────────────────────────────────────────────────

test fn entry_summary_error() -> Unit {
    let entry: LogEntry = LogEntry { level: Severity::Error, message: "e", timestamp: 0 };
    let ok: Int = match entry_summary(entry) { "ERROR" => 1, _ => 0 };
    assert_eq(ok, 1);
}

test fn entry_summary_warn() -> Unit {
    let entry: LogEntry = LogEntry { level: Severity::Warn, message: "w", timestamp: 0 };
    let ok: Int = match entry_summary(entry) { "WARN" => 1, _ => 0 };
    assert_eq(ok, 1);
}

test fn entry_summary_info() -> Unit {
    let entry: LogEntry = LogEntry { level: Severity::Info, message: "i", timestamp: 0 };
    let ok: Int = match entry_summary(entry) { "INFO" => 1, _ => 0 };
    assert_eq(ok, 1);
}

test fn entry_summary_debug() -> Unit {
    let entry: LogEntry = LogEntry { level: Severity::Debug, message: "d", timestamp: 0 };
    let ok: Int = match entry_summary(entry) { "DEBUG" => 1, _ => 0 };
    assert_eq(ok, 1);
}

// ── is_error_level tests ──────────────────────────────────────────────────

test fn is_error_level_true_for_error() -> Unit {
    let entry: LogEntry = LogEntry { level: Severity::Error, message: "e", timestamp: 0 };
    assert_eq(is_error_level(entry), true);
}

test fn is_error_level_false_for_warn() -> Unit {
    let entry: LogEntry = LogEntry { level: Severity::Warn, message: "w", timestamp: 0 };
    assert_eq(is_error_level(entry), false);
}

test fn is_error_level_false_for_info() -> Unit {
    let entry: LogEntry = LogEntry { level: Severity::Info, message: "i", timestamp: 0 };
    assert_eq(is_error_level(entry), false);
}

test fn is_error_level_false_for_debug() -> Unit {
    let entry: LogEntry = LogEntry { level: Severity::Debug, message: "d", timestamp: 0 };
    assert_eq(is_error_level(entry), false);
}

// ── build_report Debug-path isolation test ────────────────────────────────

// Debug entries increment count only — errors/warnings/infos stay at zero.
test fn build_report_debug_increments_count_only() -> Unit {
    let entries: List[LogEntry] = [
        LogEntry { level: Severity::Debug, message: "d1", timestamp: 1 },
        LogEntry { level: Severity::Debug, message: "d2", timestamp: 2 },
    ];
    let report: Report = build_report(entries);
    assert_eq(report.count,    2);
    assert_eq(report.errors,   0);
    assert_eq(report.warnings, 0);
    assert_eq(report.infos,    0);
}
