// main.mvl — Log analyzer entry point.
//
// Demonstrates:
//   1. std.json — pure MVL JSON pipeline, zero extern trust boundary
//   2. IFC labels: Tainted[String] from read_file, sanitized inside parser.mvl
//   3. Effect declarations: FileRead + Console + Log on I/O functions
//   4. Multi-module design: use imports document cross-module dependencies
//   5. stdlib usage: std.io, std.args, std.log, std.json
//   6. Phase 4: Option.map replaces manual None/Some match for level sanitization
//   7. Phase 4: std.log for structured output replacing raw println
//
// Usage:
//   mvl run examples/log_analyzer/main.mvl -- --file logs.jsonl
//   mvl run examples/log_analyzer/main.mvl -- --file logs.jsonl --level error
//
// No extern block: the whole pipeline (parse → filter → aggregate →
// encode) is native MVL, in parser.mvl. This example used to bridge the
// domain pipeline to Rust (serde_json + hand-rolled JSON encoding) before
// std.json existed.

// ── Standard library imports ────────────────────────────────────────────────

use std.args.{parse_args, required, optional, get_str, get_str_opt, ArgType, ArgValue}
use std.io.{read_file}
use std.log.{Logger, default_logger}
use errors.{RunError, run_error_message}
use parser.{LogEntry, Report, parse_lines, filter_by_level, build_report, report_to_json}

// ── Main pipeline ───────────────────────────────────────────────────────────

partial fn run(logger: val Logger) -> Result[Unit, RunError] ! FileRead + Console + Log + Env {
    let args: Map[String, ArgValue] = parse_args([
        required("file",  ArgType::Str),
        optional("level", ArgType::Str),
    ]);
    let file_path: String = get_str(args, "file", "");
    let level_opt: Option[String] = get_str_opt(args, "level");
    match read_file(file_path) {
        Err(_) => Err(RunError::IOFailure),
        Ok(content) => {
            let entries: List[LogEntry] = parse_lines(content);
            let filtered: List[LogEntry] = match level_opt {
                None      => entries,
                Some(lvl) => filter_by_level(entries, lvl),
            };
            let report: Report = build_report(filtered);
            let json_report: String = report_to_json(report);
            logger.info("analysis complete", {"output": "json"});
            println(json_report);
            Ok(())
        }
    }
}

/// Handle a run-time error: log it with the human-readable reason.
/// Effect is ! Log only — tighter than main's full effect list.
total fn handle_run_error(logger: val Logger, e: RunError) -> Unit ! Log {
    logger.error("run failed", {"reason": run_error_message(e)})
}

partial fn main() -> Unit ! FileRead + Console + Log + Env {
    let logger: Logger = default_logger();
    match run(logger) {
        Ok(_)  => (),
        Err(e) => handle_run_error(logger, e),
    }
}

// ── Internal unit tests ────────────────────────────────────────────────────

test fn check_run_error_io_failure_variant() -> Unit {
    let err: RunError = RunError::IOFailure;
    let is_io: Int = match err {
        RunError::IOFailure      => 1,
        RunError::PipelineFailed => 0,
    };
    assert_eq(is_io, 1);
}

// Option.map: None stays None, Some(v) maps through sanitize.
test fn option_map_sanitize_none_stays_none() -> Unit {
    let level: Option[Tainted[String]] = None;
    let sanitized: Option[String] = level.map(|v: Tainted[String]| relabel trust(v, "VALIDATED"));
    let is_none: Int = match sanitized {
        None    => 1,
        Some(_) => 0,
    };
    assert_eq(is_none, 1);
}

test fn option_map_sanitize_some_maps_value() -> Unit {
    let level: Option[Tainted[String]] = Some(relabel taint("error", "TEST-INPUT"));
    let sanitized: Option[String] = level.map(|v: Tainted[String]| relabel trust(v, "VALIDATED"));
    let is_some: Int = match sanitized {
        Some(_) => 1,
        None    => 0,
    };
    assert_eq(is_some, 1);
}
